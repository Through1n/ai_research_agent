# ---------- 密钥 / 环境变量（严禁入库）----------
.env
.env.*
!.env.example
*.key
*.pem

# ---------- 运行时存储（向量库、上传、缓存、日志）----------
storage/
chroma/
*.log
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# ---------- 演示过程产物（运行生成，非源码）----------
# 注意：docs/shots/ 不再忽略——README 与技术文档引用这些截图，
#      若忽略会导致推送到 GitHub 后文档图片全部裂图。
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# PyInstaller
build/
dist/
dist-release/
*.pyc
version_info.txt
build_log.txt
