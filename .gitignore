# ---------- 密钥 / 环境变量（严禁入库）----------
.env
.env.*
!.env.example
*.key
*.pem
# Streamlit Secrets：云平台密钥入口，本地调试也可能建，一旦提交等于泄露真实 Key
.streamlit/secrets.toml

# ---------- 内部工作记录（不进公开仓库）----------
.workbuddy/

# ---------- 运行时存储（向量库、上传、缓存、日志）----------
storage/
chroma/
*.log
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# ---------- 演示过程产物（运行生成，非源码）----------
# 注意：docs/shots/ 不再忽略——README 与技术文档引用这些截图，
#      若忽略会导致推送到 GitHub 后文档图片全部裂图。
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 技术文档出图产物（scripts/make_tech_pdf.py）----------
# 中间 HTML 把截图内联成 base64（单文件 8MB+），且排版扫描会产生多个命名变体，
# 这两类一律忽略；只保留最终 PDF（交付物）。
docs/_build/*.html
docs/_build/*_*.pdf

# ---------- 运行时日志 ----------
logs/

# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# PyInstaller
build/
dist/
dist-release/
*.pyc
version_info.txt
build_log.txt
