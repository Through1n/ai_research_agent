# ---------- 密钥 / 环境变量（严禁入库）----------
.env
.env.*
!.env.example
*.key
*.pem
# Streamlit Secrets：云平台密钥入口，本地调试也可能建，一旦提交等于泄露真实 Key
.streamlit/secrets.toml

# ---------- 内部工作记录（不进公开仓库）----------
.workbuddy/

# ---------- Office 文档流水线中间工作区 ----------
# output/<session-id>/ 是 docx/pdf 流水线的临时工作目录：
#   stage1/final_draft.md            S1 稿件
#   stage2/formatted-*.html          S2 版式（图片已内联成 data URI，单文件 2.8MB+）
#   stage3/_probe* / _fin* / _final* 探针与试渲染产物
# 全部是可复现的中间物，交付物是 资料/项目介绍文档.docx 与 .pdf（入库），
# 重建脚本是 scripts/_build_intro_doc.py + _fix_docx_pagesize.py + _docx_to_pdf.ps1（入库）。
# 故整目录忽略：避免 8MB 二进制中间物进 git。
output/

# ---------- 运行时存储（向量库、上传、缓存、日志）----------
storage/
chroma/
*.log
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# ---------- 演示过程产物（运行生成，非源码）----------
# 注意：资料/截图/ 不再忽略——README 与技术文档引用这些截图，
#      若忽略会导致推送到 GitHub 后文档图片全部裂图。
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 技术文档出图产物（scripts/make_tech_pdf.py）----------
# 中间 HTML 把截图内联成 base64（单文件 8MB+），成品 PDF 4.4MB，均属构建产物。
# 交付物以 md 为源，PDF 由 `python scripts/make_tech_pdf.py` 现生成，整目录忽略。
资料/_构建/

# 引用校验器快照：默认当 scratch 忽略，但 _chk_before/_chk_after 是文档第 6 行
# 「修复前 1-4 章抽样 103 条中 86 条对不上 / 修复后 215 条 0 疑似」的一手证据，
# 属交付物，单独放行（其它 _chk_* 仍忽略）。
资料/复盘/_chk_*.txt
!资料/复盘/_chk_before.txt
!资料/复盘/_chk_after.txt

# 截图工作稿：_crop_*（裁剪试作）/ _full_*（重拍前长图原稿）/ _p*_v（版本稿）。
# 正式图只有 p0-p6.png，这些是过程稿，不进包。
资料/截图/_*.png

# ---------- 运行时日志 ----------
logs/

# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# PyInstaller
build/
build_new/
dist/
dist_old_*/
dist-release/
*.pyc
version_info.txt
# 例外：AI4SResearchAgent.spec 里 version="version_info.txt" 硬依赖它，
# 忽略掉等于「从新克隆的仓库打不出桌面版」（PyInstaller 直接因缺文件失败），
# 品牌字段（ProductName / CompanyName = MoreHand）也随它丢失。必须入库。
!version_info.txt
build_log.txt

# ---------- 应用发布标记文件（内部产物，非交付物）----------
.wbapp_*.genie

# ---------- 官方测试 PDF（Round 15：不再随仓库分发，改为现拉现用） ----------
# UnderstandingDeepLearning_02_09_26_C.pdf 是 22MB 受版权保护教材原著，随公开仓库
# 分发有法律风险。六件测试 PDF 统一改为 `sh scripts/fetch_pdfs.sh` 现拉现用：
#   arXiv 三件下载、扫描件/长文档夹具本地生成、教材按官网说明自行放置。
论文样本/*.pdf
