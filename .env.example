# ============================================================================
#  AI4S 科研助手 Agent —— 环境变量模板
# ----------------------------------------------------------------------------
#  用法：cp .env.example .env  然后按需取消注释并填写。
#
#  ⚠️ 安全红线（赛题明文要求「API 密钥不得出现在公开仓库」）：
#     · 本文件只放**变量名与占位说明**，严禁填入任何真实密钥
#     · 真实 .env 已被 .gitignore 与 .dockerignore 双重排除，不会进仓库也不会进镜像
#     · 生产环境请用容器 env_file / docker run -e / systemd EnvironmentFile 注入
#     · 完全不配 Key 也能用：打开应用后点侧边栏「🚀 一键加载演示数据」体验全部离线链路
#
#  本清单已按代码中实际读取位置逐个核对（共 23 个可被用户配置的变量）：
#    config.py 14 个 · core/providers.py 2 个 · core/llm.py 1 个
#    services/state.py 1 个 · services/extern.py 2 个 · desktop/paths.py 1 个
#    HF_ENDPOINT 1 个（config.py 的 setdefault）
#    （另有 APPDATA 为 Windows 系统自带变量，无需配置，故不计入）
# ============================================================================


# ===== 1. 大模型 Provider（统一走 OpenAI 兼容协议，可热切换） =====

# 选择内置 Provider：zhipu | deepseek | qwen | openai | ollama
# 读取位置：services/state.py:57（应用启动时的默认 Provider）
# 也可在侧边栏「接入方式 → 🏢 预设平台」下拉切换，无需改这里
LLM_PROVIDER=zhipu

# —— 各 Provider 的 API Key（按需填其一，环境变量自动匹配当前 Provider）——
# ⚠️ 下方一律保持空值，**切勿填入真实密钥**
# 读取位置：core/providers.py:122 resolve_key()（按 Provider.key_env 取值，再回退 LLM_API_KEY）
#           core/llm.py:281（OpenAI 客户端的兜底取值）
ZHIPU_API_KEY=                            # 智谱 glm-4-flash / glm-4v（唯一内置视觉模型，多模态 OCR ✅）
DEEPSEEK_API_KEY=                         # deepseek-chat（无视觉模型，OCR 自动降级为离线解析）
DASHSCOPE_API_KEY=                        # 通义千问 qwen-turbo / qwen-vl-plus（✅）
OPENAI_API_KEY=                           # gpt-4o-mini（✅，需国际网络环境）
# 本地 Ollama：先 `ollama serve` + `ollama pull qwen2.5:7b` 即可使用。
# 因其 needs_key=False，resolve_key() 会直接返回占位值 "local"，下面这个变量留空也能跑
OLLAMA_API_KEY=

# —— 通用兜底 Key（上面对应项没填时，代码会再来这里取一次）——
# 读取位置：core/providers.py:122、core/llm.py:281、config.py:65
# 适合只用一个 Provider、不想记变量名的场景
LLM_API_KEY=

# —— 覆盖 API 端点（自建网关 / 内网代理时才需要；内置 Provider 不必填）——
# 读取位置：config.py:64，默认 https://open.bigmodel.cn/api/paas/v4/
# 注意：填了会覆盖所选 Provider 自带的 base_url
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/


# ===== 2. 高级：自定义 Provider（内网网关等，JSON 数组） =====
# 读取位置：core/providers.py:79 _extra_providers()
# 追加后会出现在侧边栏「选择平台」下拉列表里
# LLM_PROVIDERS_EXTRA=[{"id":"mycloud","label":"公司内网","base_url":"http://10.0.0.8/v1","model":"qwen2.5-14b","multimodal":false}]


# ===== 3. 覆盖默认模型名 / 超时（一般不用改） =====
# 读取位置：config.py:66-68
# LLM_MODEL=glm-4-flash                  # 文本 / 任务规划 / Function Calling 用的模型
# VL_MODEL=glm-4v                        # 多模态 / 扫描件 OCR 用的视觉模型
# LLM_TIMEOUT=90                         # 单次调用超时（秒）
# LLM_RETRY_BUDGET_SEC=45                # 单次调用的**总时长预算**（秒）：同一条链路
#                                        # （1 次立即尝试 + 最多 3 次退避重试）累计超过
#                                        # 它就放弃重试、直接人话降级，防止演示现场转圈
#                                        # 几分钟。只决定"要不要再试"，不裁剪单次窗口。
#                                        # 想让最坏等待也压到 45s，把 LLM_TIMEOUT 一并设成 45。
# MAX_UPLOAD_MB=100                      # 单个上传 PDF 的体积上限（解析前的应用层闸门）


# ===== 4. GitHub API（可选，提升「个性化推荐」里开源代码可得性的检出率） =====
# 读取位置：services/extern.py:13；不配则匿名调用（GitHub 未鉴权限额较低，会自动降级）
# token 只需 public_repo 只读权限即可
# GITHUB_TOKEN=
# GITHUB_API_TOKEN=                      # 备用变量名，与上面二选一


# ===== 5. HuggingFace 镜像（Chroma 默认 embedding 首次下载用） =====
# 读取位置：config.py:71（os.environ.setdefault —— 只有外部设了才生效）
# 国内服务器部署务必保留，否则首次加载模型会卡在下载
HF_ENDPOINT=https://hf-mirror.com


# ===== 6. 检索 / 解析参数（默认值已调优，与 README 实测数据一致） =====
# 读取位置：config.py:74-80
# CHUNK_SIZE=1200                        # 切块目标字符数
# CHUNK_OVERLAP=150                      # 相邻分块重叠字符数（保证跨块语义连续）
# DENSE_K=12                             # 向量召回条数
# SPARSE_K=12                            # BM25 稀疏召回条数（两路经 RRF 融合）
# FINAL_K=6                              # 融合后最终进入上下文的片段数
# DEDUP_THRESHOLD=0.90                   # 语义去重相似度阈值，超限弹出重复入库预警
# AGENT_MAX_ITERS=8                      # Agent 函数调用闭环的最大轮数（防死循环）
# AGENT_GLOBAL_MAX_ITERS=40              # 全局迭代总上限（防多任务叠加时无限循环）
#                                        # 读取位置：core/agent.py:48；不设则按任务数自动推导


# ===== 7. 运行模式开关 =====
# 读取位置：config.py:10、desktop/paths.py:21、ui/desktop_chrome.py:32
# 设为 1 时进入「桌面模式」：数据与资源分离到 %APPDATA%/AI4SResearchAgent
# ⚠️ Docker / Web 部署请务必留空或不设，否则 storage 路径会跑偏
# AI4S_DESKTOP=0
