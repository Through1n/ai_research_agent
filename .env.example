# ===== 大模型 Provider（OpenAI 兼容协议，可灵活切换） =====
# 选择内置 Provider：zhipu | deepseek | qwen | openai | ollama
# 也可在应用侧边栏直接下拉切换
LLM_PROVIDER=zhipu

# —— 各 Provider 的 API Key（按需填其一，环境变量自动匹配当前 Provider）——
ZHIPU_API_KEY=请填入你的智谱API Key          # glm-4-flash / glm-4v（多模态 ✅）
DEEPSEEK_API_KEY=                            # deepseek-chat（多模态 ❌，OCR 自动降级）
DASHSCOPE_API_KEY=                           # 通义千问 qwen-turbo / qwen-vl-plus（✅）
OPENAI_API_KEY=                              # gpt-4o-mini（✅）
# 本地 Ollama 无需真实密钥，ollama serve + ollama pull qwen2.5:7b 后即可使用

# —— 高级：自定义 Provider（内网网关等，JSON 数组）——
# LLM_PROVIDERS_EXTRA=[{"id":"mycloud","label":"公司内网","base_url":"http://10.0.0.8/v1","model":"qwen2.5-14b","multimodal":false}]

# —— 覆盖默认模型名（一般不用改）——
# LLM_MODEL=glm-4-flash
# VL_MODEL=glm-4v
# LLM_TIMEOUT=90

# ===== 检索 / 解析参数（默认值已调优） =====
# CHUNK_SIZE=1200
# DENSE_K=12
# SPARSE_K=12
# FINAL_K=6
# DEDUP_THRESHOLD=0.90
# AGENT_MAX_ITERS=8
