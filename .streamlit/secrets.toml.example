# ============================================================================
#  AI4S 科研助手 Agent —— Streamlit Secrets 模板
# ----------------------------------------------------------------------------
#  两种注入方式（二选一，推荐方式 A，不落盘更安全）
#
#  A. Streamlit Community Cloud 后台（推荐）
#     部署完成后 → 右下角「⋯」→ Settings → Secrets
#     把下面去掉注释后的内容整段粘贴进文本框 → Save
#     （平台会重启应用，约 30–60 秒生效）
#
#  B. 本地调试 / 自建服务器
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#     然后填入真实值
#
#  ⚠️ 安全红线（赛题明文要求「API 密钥不得出现在公开仓库」）
#     · 本模板只放变量名与占位说明，**严禁填真实密钥**
#     · .streamlit/secrets.toml 已被 .gitignore 与 .dockerignore 双重排除
#     · 完全不配 Key 也能演示：打开应用后点侧边栏「🚀 一键加载演示数据」
#
#  变量名与代码读取位置已逐个核对（config.py / services/state.py / services/extern.py）
# ============================================================================


# ===== 1. 大模型 Provider =====
# 内置可选：zhipu | deepseek | qwen | openai | ollama
# 读取位置：services/state.py:57（启动默认 Provider）
# 也可在侧边栏「接入方式 → 🏢 预设平台」下拉热切换，无需改这里
LLM_PROVIDER = "zhipu"

# 智谱：glm-4-flash 用于文本/规划/Function Calling；glm-4v 用于多模态 OCR
# （glm-4v 是本项目唯一内置的视觉模型，扫描件 OCR 依赖它）
# 读取位置：config.py:120（ZHIPU_API_KEY，其次回落 LLM_API_KEY）
ZHIPU_API_KEY = "your-zhipu-api-key"

# 其余平台按需填写；留空即不启用（不影响其他链路）
DEEPSEEK_API_KEY = ""
DASHSCOPE_API_KEY = ""
OPENAI_API_KEY = ""
OLLAMA_API_KEY = ""

# 通用兜底（任意 OpenAI 兼容端点，如内网网关 / 自建 vLLM）
# 读取位置：config.py（LLM_API_KEY / LLM_BASE_URL）
LLM_API_KEY = ""
LLM_BASE_URL = ""


# ===== 2. 可选覆盖（一般保持默认即可） =====
# 单次调用超时（秒）。默认 45 是「演示保险」取舍：
# 失败时最坏等待 ≈45s（原 90s），同时给慢生成留足窗口。
# 现场想更严可设 25（最坏 ≈25s，但长综述可能提前降级）。
# 读取位置：config.py:123
LLM_TIMEOUT = 45

# 单次调用总时长预算（秒）：1 次立即尝试 + 最多 3 次退避重试，
# 累计超预算即放弃重试、直接人话降级。只决定「要不要再试」，不裁剪单次窗口。
# 读取位置：config.py:128
LLM_RETRY_BUDGET_SEC = 20

# 单个上传 PDF 体积上限（MB），解析前的应用层闸门
# 读取位置：config.py:144
MAX_UPLOAD_MB = 100


# ===== 3. HuggingFace 镜像 =====
# ⚠️ 云平台（Streamlit Cloud / HF Spaces，服务器在境外）请**留空或删掉这一行**，
#    让它走默认的 huggingface.co。填国内镜像会让 chroma 默认 embedding
#    的首次下载明显变慢，甚至超时卡住。
#    仅「国内自建服务器」或「桌面版」才需要设成镜像。
# 读取位置：config.py:131（os.environ.setdefault，外部设了才生效）
HF_ENDPOINT = ""


# ===== 4. GitHub API（可选） =====
# 提升「个性化推荐」里开源代码可得性的检出率。
# token 只需 public_repo 只读权限；不配则匿名调用，限额较低会自动降级。
# 读取位置：services/extern.py:13
GITHUB_TOKEN = ""
